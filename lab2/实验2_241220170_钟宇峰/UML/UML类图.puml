@startuml UML类图
' 校园二手交易平台 —— 类图
' 依据：lab1/实验1_241220170_钟宇峰/requirements.md（REQ-001 ~ REQ-030）
title 校园二手交易平台 类图

skinparam classAttributeIconSize 0
hide circle
skinparam packageStyle rectangle

' ============ 实体类 ============

class 用户 <<实体>> {
  - 用户ID : String {PK}
  - 手机号 : String {唯一, 可空}
  - 学号 : String {唯一, 可空}
  - 密码 : String {密文, >=6位}
  - 需改密 : Bool
  - 昵称 : String
  - 联系方式 : String
  - 账号状态 : 账号状态
  - 封禁原因 : String {可空}
  - 当前权限 : 当前权限
  ==
  + 注册()
  + 登录()
  + 修改密码()
  + 修改资料()
  + 申请卖家()
  + 查询商品()
  + 发起预约()
  + 取消预约()
  + 建草稿()
  + 提交审核()
  + 修改自己商品()
  + 下架()
  + 确认预约()
  + 完成交易()
  + 审核商品()
  + 违规下架()
  + 封禁()
  + 解封()
  + 查询日志()
  + 查看报表()
}

class 商品 <<实体>> {
  - 商品ID : String {PK}
  - 标题 : String
  - 描述 : String
  - 分类 : 商品分类
  - 价格 : Decimal
  - 成色 : 成色
  - 图片 : String[1..*] {URL}
  - 交易方式 : String
  - 交易地点 : String
  - 联系方式 : String {默认取卖家联系方式}
  - 当前状态 : 商品状态
  - 发布时间 : DateTime {系统维护}
  ==
  + 保存草稿()
  + 提交审核()
  + 修改()
  + 下架()
  + 违规下架()
  + 完成交易()
}

class 预约 <<实体>> {
  - 预约ID : String {PK}
  - 发起时间 : DateTime
  - 状态 : 预约状态
  - 确认时间 : DateTime {可空}
  ==
  + 发起()
  + 确认()
  + 删除()
}

class 卖家认证申请 <<实体>> {
  - 申请ID : String {PK}
  - 姓名 : String
  - 提交时间 : DateTime
  - 审核状态 : 认证审核状态
  - 审核时间 : DateTime {可空}
  - 驳回理由 : String {可空}
  ==
  + 提交()
  + 审核()
}

class 审核记录 <<实体>> {
  - 记录ID : String {PK}
  - 审核结果 : 审核结果
  - 审核时间 : DateTime
  - 理由 : String {可空}
}

class 操作日志 <<实体>> {
  - 日志ID : String {PK}
  - 操作时间 : DateTime
  - 操作类型 : 日志类型
  - 对象类型 : String
  - 对象ID : String
  - 说明 : String {可空}
  ==
  + 查询()
}

' ============ 枚举 ============

enum 账号状态 {
  正常
  已封禁
}

enum 当前权限 {
  买家
  卖家
  管理员
}

enum 商品状态 {
  草稿
  待审核
  驳回
  已发布
  已确认
  已下架
  违规下架
  交易完成
}

enum 预约状态 {
  待确认
  已成功
}

enum 认证审核状态 {
  待审核
  通过
  驳回
}

enum 审核结果 {
  通过
  驳回
}

enum 商品分类 {
  教材
  数码
  服饰
  生活用品
}

enum 成色 {
  全新
  九成新
  有瑕疵
}

enum 日志类型 {
  注册
  提交审核
  审核
  下架
  违规处置
  封禁
  解封
  发起预约
  取消预约
  确认预约
  预约记录删除
  完成交易
}

' ============ 关联关系 ============

用户 "1" -- "0..*" 商品 : 发布者 >
用户 "1" -- "0..*" 预约 : 买家 >
商品 "1" -- "0..*" 预约 : 被预约 >
用户 "1" -- "0..*" 卖家认证申请 : 申请人 >
用户 "1" -- "0..*" 卖家认证申请 : 审核人 >
商品 "1" -- "0..*" 审核记录 : 被审核 >
用户 "1" -- "0..*" 审核记录 : 审核人 >
用户 "1" -- "0..*" 操作日志 : 操作人 >

' ============ 约束 ============

note right of 预约
  {OCL}
  同一商品中 状态=已成功 的预约数量 <= 1
  （REQ-019 / REQ-023）
  失效 = 删除记录，不保留状态值
end note

note bottom of 商品
  {OCL}
  当前状态=已确认 => 存在且仅存在一条 已成功 预约
  当前状态=交易完成 => 不可再发起或确认预约
  （REQ-012 / REQ-023 / REQ-029）
end note

note right of 用户
  {OCL}
  手机号 <> 空 或 学号 <> 空
  昵称、联系方式必填（REQ-001）
  卖家权限 = 买家权限的超集
  管理员不在层级内，不参与买卖
end note

note right of 操作日志
  对象类型/对象ID 构成多态关联，
  可指向 用户 / 商品 / 预约 / 卖家认证申请
  （日志不可修改，REQ-021）
end note

note top of 用户
  封禁账号登录时展示 封禁原因 + 管理员联系方式（REQ-016）
  管理员联系方式与封禁提示文案属部署配置项，不进领域模型
end note

@enduml
